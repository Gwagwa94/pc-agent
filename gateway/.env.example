# ============================================================
# PC-Agent Gateway — Configuration (copy to .env, never commit)
# ============================================================

# Port the gateway listens on (map to 80/443 behind nginx/caddy)
GATEWAY_PORT=14000

# Single-user auth
GATEWAY_USER=greg

# Generate with:
#   node -e "import('bcryptjs').then(b=>b.default.hash('YOUR_PASSWORD',12).then(console.log))"
GATEWAY_PASS_HASH=$2b$12$REPLACE_ME_WITH_REAL_BCRYPT_HASH

# Random secret for session signing (use `openssl rand -hex 32`)
SESSION_SECRET=REPLACE_ME_WITH_RANDOM_32_CHAR_SECRET

# PC Agent URL (via WireGuard)
PC_AGENT_URL=http://10.7.0.2:2999

# Shared secret token between gateway and PC agent (use `openssl rand -hex 32`)
API_SECRET=REPLACE_ME_WITH_SHARED_API_SECRET

# Set to true if the gateway is behind a TLS-terminating reverse proxy (nginx/caddy)
HTTPS=false
