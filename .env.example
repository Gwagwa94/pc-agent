# Port 2999 pour éviter tout conflit avec d'autres projets sur le port 3000
PORT=2999

# Interface d'écoute (0.0.0.0 pour écouter sur WireGuard et Localhost, ou 10.7.0.2 pour WireGuard uniquement)
BIND_HOST=0.0.0.0

# Modèles Dual-Brain & Contexte
PLANNER_MODEL=gemma-4-26b-a4b
PLANNER_CONTEXT_LENGTH=32768
EXECUTOR_MODEL=ui-tars-1.5-7b
EXECUTOR_CONTEXT_LENGTH=16384

# Serveur local LM Studio (port 1234)
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen3.5-9b-claude-4.6-highiq-instruct-heretic-uncensored

# Port Chrome DevTools pour piloter l'onglet Gemini Web (optionnel)
CHROME_CDP_URL=http://127.0.0.1:9222

# Chemin vers uvx.exe
UVX_PATH=C:/Users/grego/.local/bin/uvx.exe

# ── API Secret (partagé avec le gateway VPS) ──────────────────────────────────
# Générer avec : openssl rand -hex 32
API_SECRET=REPLACE_ME_WITH_SHARED_API_SECRET
